# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Production Site URL (Optional, auto-detected on Vercel/Render)
# Set to your live URL (e.g., https://studysnap.vercel.app) to ensure auth emails redirect correctly
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini API Key
# Generate from https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
